# Cloudflare Pages headers config — applied to every response.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/
# Order matters: more specific paths override less specific.

/*
  # ── Security ────────────────────────────────────────────────
  # HSTS — force HTTPS for a year, preload-ready (submit at hstspreload.org
  # only AFTER the site has been live on HTTPS for 30+ days).
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Block MIME sniffing — file extensions are authoritative.
  X-Content-Type-Options: nosniff
  # Clickjacking defense — only same-origin can frame.
  X-Frame-Options: SAMEORIGIN
  # Referer leaks only the origin, never the path, to cross-origin requests.
  Referrer-Policy: strict-origin-when-cross-origin
  # Permissions-Policy — explicitly deny the powerful features we don't use.
  # Geolocation IS used (locate-fab on map) so we allow self.
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), geolocation=(self)
  # CSP — strict: every script and stylesheet is same-origin (no inline
  # handlers; forms use [data-no-submit] in city.js), fonts self-hosted.
  # 'unsafe-inline' on style-src is retained ONLY because MapLibre
  # injects inline width/height on the canvas elements it manages;
  # removing it breaks the map. img-src https: keeps the Supabase Storage
  # CDN (pick-images bucket) working without whitelisting each host.
  # worker-src 'self' blob: is REQUIRED by MapLibre: it spawns its
  # tile-processing worker from a blob: URL. Without this, worker-src
  # falls back to script-src ('self'), the blob
  # worker is refused, and the map canvas mounts but never paints any
  # tiles. This does NOT loosen main-thread script execution — page
  # scripts stay locked to 'self'; only blob workers are allowed.
  Content-Security-Policy: default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self' https://*.supabase.co https://tiles.openfreemap.org; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# ── Caching ─────────────────────────────────────────────────
# HTML: never cache aggressively — fixes need to propagate fast. Cloudflare's edge cache picks
# the latest on each request; browsers get a short max-age.
/*.html
  Cache-Control: public, max-age=300, must-revalidate

# Stylesheets and marks.svg carry no content hash, so they stay on the
# 5-minute /* rule above (marks.js fetches marks.svg at runtime).
#
# Static brand assets below are immutable by design.
/brand/*
  Cache-Control: public, max-age=2592000, immutable

/assets/*
  Cache-Control: public, max-age=2592000, immutable

# The service worker must never be served stale: a cached sw.js pins the
# whole app to whatever it was built against, and the 5-minute /* rule
# would do exactly that for five minutes after every deploy.
/sw.js
  Cache-Control: no-cache

# Favicons / manifest: 1 day — these rotate rarely but not "never".
/favicon.ico
  Cache-Control: public, max-age=86400
/apple-touch-icon.png
  Cache-Control: public, max-age=86400
/manifest.webmanifest
  Cache-Control: public, max-age=86400
