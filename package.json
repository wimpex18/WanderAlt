{
  "name": "wanderalt",
  "version": "0.9.0",
  "private": true,
  "scripts": {
    "start": "node .scripts/dev-server.js",
    "pipeline": "node --env-file-if-exists=.env pipeline/run.ts",
    "pipeline:dry": "node --env-file-if-exists=.env pipeline/run.ts --dry-run",
    "pipeline:models": "node --env-file-if-exists=.env pipeline/run.ts --models",
    "places:audit": "node --env-file-if-exists=.env pipeline/maintenance.ts --dry-run",
    "places:maintain": "node --env-file-if-exists=.env pipeline/maintenance.ts --check-osm",
    "test": "node --test \"pipeline/test/*.test.ts\"",
    "typecheck": "tsc -p pipeline",
    "build:icons": "node .scripts/rasterize-favicons.js",
    "build:map-styles": "node .scripts/build-map-styles.js"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "http-server": "^14.1.1",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24"
  }
}
