{
  "version": 8,
  "name": "WanderAlt editorial-dusk",
  "metadata": {
    "wanderalt:notes": "Custom MapLibre style. Newsprint cream land, muted petrol water, off-white roads on muted casing, JetBrains-style mono labels. Tile source: OpenFreeMap (free, OSM, no API key)."
  },
  "sources": {
    "openfreemap": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sprite": "https://tiles.openfreemap.org/sprites/ofm_f384/ofm",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#2a2b2d"
      }
    },
    {
      "id": "park",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "landcover",
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "wood"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "grass"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "park"
        ]
      ],
      "paint": {
        "fill-color": "#2c3a2f",
        "fill-opacity": 0.85
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "water",
      "paint": {
        "fill-color": "#1d2a35",
        "fill-antialias": true
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#1d2a35",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.4,
          16,
          1.6
        ]
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "openfreemap",
      "source-layer": "building",
      "minzoom": 13,
      "paint": {
        "fill-color": "#333437",
        "fill-outline-color": "#3c3d41",
        "fill-opacity": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0,
          14,
          0.7,
          17,
          0.9
        ]
      }
    },
    {
      "id": "road-minor",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "minzoom": 13,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "minor"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "service"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "track"
        ]
      ],
      "paint": {
        "line-color": "#46484d",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          13,
          0.5,
          18,
          4
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "secondary"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "tertiary"
        ]
      ],
      "paint": {
        "line-color": "#4d4f55",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          10,
          0.6,
          18,
          6
        ]
      }
    },
    {
      "id": "road-primary-casing",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "primary"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "trunk"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "motorway"
        ]
      ],
      "paint": {
        "line-color": "#3a3b3f",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          1,
          18,
          10
        ]
      }
    },
    {
      "id": "road-primary",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "primary"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "trunk"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "motorway"
        ]
      ],
      "paint": {
        "line-color": "#5a5c62",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          8,
          0.6,
          18,
          8
        ]
      }
    },
    {
      "id": "rail",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "transportation",
      "minzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "rail"
      ],
      "paint": {
        "line-color": "#44464b",
        "line-width": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          12,
          0.4,
          18,
          1.4
        ],
        "line-dasharray": [
          3,
          2
        ]
      }
    },
    {
      "id": "boundary-admin",
      "type": "line",
      "source": "openfreemap",
      "source-layer": "boundary",
      "filter": [
        "<=",
        [
          "get",
          "admin_level"
        ],
        4
      ],
      "paint": {
        "line-color": "#5a5c62",
        "line-width": 0.5,
        "line-dasharray": [
          4,
          3
        ],
        "line-opacity": 0.6
      }
    },
    {
      "id": "place-suburb-label",
      "type": "symbol",
      "source": "openfreemap",
      "source-layer": "place",
      "minzoom": 11,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "suburb"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "neighbourhood"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "quarter"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          11,
          9,
          16,
          13
        ],
        "text-letter-spacing": 0.18,
        "text-transform": "uppercase",
        "text-padding": 8
      },
      "paint": {
        "text-color": "#ecebe6",
        "text-halo-color": "#2a2b2d",
        "text-halo-width": 1.4,
        "text-halo-blur": 0.4
      }
    },
    {
      "id": "place-village-label",
      "type": "symbol",
      "source": "openfreemap",
      "source-layer": "place",
      "minzoom": 9,
      "maxzoom": 14,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "village"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "town"
        ]
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          9,
          10,
          14,
          14
        ],
        "text-letter-spacing": 0.1
      },
      "paint": {
        "text-color": "#cfcec8",
        "text-halo-color": "#2a2b2d",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-city-label",
      "type": "symbol",
      "source": "openfreemap",
      "source-layer": "place",
      "minzoom": 4,
      "maxzoom": 12,
      "filter": [
        "==",
        [
          "get",
          "class"
        ],
        "city"
      ],
      "layout": {
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Bold"
        ],
        "text-size": [
          "interpolate",
          [
            "linear"
          ],
          [
            "zoom"
          ],
          4,
          11,
          12,
          16
        ],
        "text-letter-spacing": 0.15,
        "text-transform": "uppercase"
      },
      "paint": {
        "text-color": "#ecebe6",
        "text-halo-color": "#2a2b2d",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "road-label-primary",
      "type": "symbol",
      "source": "openfreemap",
      "source-layer": "transportation_name",
      "minzoom": 13,
      "filter": [
        "any",
        [
          "==",
          [
            "get",
            "class"
          ],
          "primary"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "secondary"
        ],
        [
          "==",
          [
            "get",
            "class"
          ],
          "tertiary"
        ]
      ],
      "layout": {
        "symbol-placement": "line",
        "text-field": [
          "get",
          "name"
        ],
        "text-font": [
          "Noto Sans Regular"
        ],
        "text-size": 11,
        "text-letter-spacing": 0.05
      },
      "paint": {
        "text-color": "#c4c3bd",
        "text-halo-color": "#3a3b3f",
        "text-halo-width": 1.6
      }
    }
  ]
}
