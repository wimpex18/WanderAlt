# Local dev secrets — never commit. Cloud sessions set these as env vars
# in the cloud environment settings instead.
local-secrets.js

# Personal Claude Code settings (machine-specific permissions, etc.)
.claude/settings.local.json
CLAUDE.local.md

# Node / npx caches
node_modules/

# macOS
.DS_Store

# Ad-hoc captures from the harnesses. NB .screenshots/visual-baselines/ is
# NOT ignored — those PNGs are the committed pixel-diff baselines that
# `npm run visual` asserts against.
.screenshots/*.png
.screenshots/audit/

# Playwright test-runner artifacts (failure diffs, traces, reports).
test-results/
playwright-report/
